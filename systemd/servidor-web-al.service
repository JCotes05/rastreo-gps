[Unit]
Description=Servidor Web - Sistema de Rastreo GPS
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user
ExecStart=/usr/bin/python3 -u /home/ec2-user/servidor_web.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ec2-user/salida_web.log
StandardError=append:/home/ec2-user/salida_web.log

[Install]
WantedBy=multi-user.target
