[Unit]
Description=Servidor Web - Sistema de Rastreo GPS
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/bin/python3 -u /home/ubuntu/servidor_web.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/salida_web.log
StandardError=append:/home/ubuntu/salida_web.log

[Install]
WantedBy=multi-user.target
